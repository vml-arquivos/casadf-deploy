# CasaDF CRM - Exemplo de variáveis de ambiente

## Banco de Dados PostgreSQL
# Usuário do banco
DB_USER=casadf_admin
# Senha do banco
DB_PASSWORD=supersecretpassword
# Nome do banco de dados
DB_NAME=casadf_crm

# URL de conexão completa (usado pela aplicação)
# Formato: postgresql://usuario:senha@host:porta/database
# Em Docker: host é "db" (nome do serviço)
# Em VPS local: host é "localhost"
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@db:5432/${DB_NAME}

## Servidor
# Porta onde a aplicação vai rodar
PORT=5000

# Ambiente de execução (development, production)
NODE_ENV=production

## Chave secreta JWT
# Gere uma nova chave com `openssl rand -base64 32` e copie aqui.
JWT_SECRET=b3xTnStM9fhETM8ETpdTpu/loSRzz1seJqETfqKuYus=

## CORS / Origens Permitidas
# Separe múltiplos domínios por vírgula. Inclua http://localhost:3000 durante o desenvolvimento.
ALLOWED_ORIGINS=http://localhost:3000,https://app.casadf.com.br
# Endpoint público do seu N8N para receber webhooks
N8N_WEBHOOK_URL=

# Token da API do WhatsApp Business, se você integrar
WHATSAPP_API_TOKEN=

# ============================================
# CREDENCIAIS PARA N8N
# ============================================
# Para conectar o N8N ao banco de dados PostgreSQL,
# use as mesmas credenciais configuradas acima:
#
# No N8N, crie uma conexão PostgreSQL com:
# - Host: IP_DA_VPS (ou 'localhost' se N8N estiver no mesmo servidor)
# - Port: 5432
# - Database: casadf_crm (valor de DB_NAME)
# - User: casadf_admin (valor de DB_USER)
# - Password: (mesmo valor de DB_PASSWORD)
# - SSL: Disable (conexão local) ou Enable (conexão remota)
#
# Endpoints de Webhook disponíveis:
# - POST /api/webhooks/leads/ingest - Ingestão de leads
# - POST /api/webhooks/clients/save - Salvar cliente
# - POST /api/webhooks/clients/interests - Salvar interesse
# - POST /api/webhooks/visits/schedule - Agendar visita
# - POST /api/webhooks/messages/buffer - Buffer de mensagens
# - POST /api/webhooks/ai/context - Contexto da IA
# - POST /api/webhooks/properties/search - Buscar imóveis
